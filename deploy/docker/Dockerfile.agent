# Multi-stage build for calico-plumber Node Agent (CO-RE eBPF + Legacy Conntrack/INET_DIAG)
ARG GO_IMAGE=golang:1.26-bookworm
ARG RUNTIME_IMAGE=debian:bookworm-slim

# Stage 1: Compile CO-RE eBPF bytecode (bpf2go) + Go Agent binary
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS builder
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang llvm libbpf-dev make \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/ ./cmd/
COPY pkg/ ./pkg/
RUN go generate ./pkg/agent/telemetry/bpf/... && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -tags ebpf -trimpath -ldflags="-s -w" -o /out/calico-netdiag-agent ./cmd/agent

# Stage 2: Runtime image with real Linux dataplane & packet capture tools
FROM ${RUNTIME_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tcpdump \
    iproute2 \
    iptables \
    ipvsadm \
    conntrack \
    util-linux \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/calico-netdiag-agent /usr/local/bin/calico-netdiag-agent
EXPOSE 9191
ENTRYPOINT ["/usr/local/bin/calico-netdiag-agent"]
